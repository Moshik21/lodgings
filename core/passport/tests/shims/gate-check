#!/usr/bin/env python3
"""Fake read-only custody command for the e2e run: prints a recorded output file and exits 0.

  gate-check <fixture-file> [exit-code]
"""

import sys

with open(sys.argv[1], "r", encoding="utf-8") as fh:
    sys.stdout.write(fh.read())
sys.exit(int(sys.argv[2]) if len(sys.argv) > 2 else 0)
