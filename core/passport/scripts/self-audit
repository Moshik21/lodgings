#!/usr/bin/env python3
"""self-audit: refuse personal names, hosts, paths, addresses and secrets in the product tree.

  scripts/self-audit [--denylist FILE ...] [ROOT ...]

The denylist files live OUTSIDE the repository (one term per line, `#` comments,
case-insensitive substring match), so the list of private words is never
published with the product. --denylist may be given more than once and every
file is applied; without it the denylist is $LODGINGS_AUDIT_DENYLIST, else
~/.config/lodgings/self-audit.denylist.
Denylist terms and the built-in rules below apply to every file scanned.

One documented exception: the `Copyright (c) <year> <holder>` line of a file
named LICENSE is exempt from denylist terms, because the licence must name
its holder.

Exit codes: 0 clean, 1 findings, 2 no denylist found (an audit without it
is not a pass). Findings print as `path:line: rule`, never the matched text.
"""

import argparse
import os
import re
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
PRODUCT = os.path.dirname(HERE)                      # core/passport
REPO = os.path.dirname(os.path.dirname(PRODUCT))     # repository root
DEFAULT_ROOTS = [PRODUCT]
SKIP_DIRS = {".git", "__pycache__", ".mypy_cache", "dist", "build"}
LICENSE_LINE = re.compile(r"^Copyright \(c\) \d{4}(-\d{4})? \S")

BUILTIN = [
    ("email address", re.compile(r"[A-Za-z0-9._%+-]+@(?!example\.(com|org|net)\b)(?![A-Za-z0-9.-]*\.invalid\b)"
                                 r"[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}")),
    ("home path", re.compile(r"(/home/[a-z_][a-z0-9_-]*|/Users/[A-Za-z][A-Za-z0-9._-]*|[A-Za-z]:\\\\?Users\\\\?[A-Za-z])")),
    ("mesh-VPN host name", re.compile(r"\b[a-z0-9-]+\.ts\.net\b|\btail[0-9a-f]{4,}\b")),
    ("CGNAT address", re.compile(r"\b100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}\b")),
    ("private key", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    ("access token", re.compile(r"\b(gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|AKIA[0-9A-Z]{16}|xox[abposr]-[A-Za-z0-9-]{10,})")),
]
# Placeholder paths used in docs and examples on purpose.
ALLOWED_PATHS = re.compile(r"/home/(you|user|me)\b|/Users/(you|user|me)\b|C:\\\\?Users\\\\?(you|user|me)\b", re.I)


def load_denylist(path):
    terms = []
    with open(path, "r", encoding="utf-8") as fh:
        for line in fh:
            t = line.strip()
            if t and not t.startswith("#"):
                terms.append(t.lower())
    return terms


def find_denylists(args):
    if args:
        return args if all(os.path.isfile(a) for a in args) else []  # a named file that is missing is not a pass
    for cand in (os.environ.get("LODGINGS_AUDIT_DENYLIST"), os.path.expanduser("~/.config/lodgings/self-audit.denylist")):
        if cand and os.path.isfile(cand):
            return [cand]
    return []


def files(roots):
    for root in roots:
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS)
            for name in sorted(filenames):
                yield os.path.join(dirpath, name)


def main():
    ap = argparse.ArgumentParser(description="Refuse personal names, hosts, paths and secrets in the product tree.")
    ap.add_argument("--denylist", action="append", default=[], help="file of private terms, kept outside the repository; repeatable")
    ap.add_argument("roots", nargs="*", help="directories to scan (default: this product)")
    args = ap.parse_args()
    paths = find_denylists(args.denylist)
    if not paths:
        print("unknown · no denylist found (--denylist, $LODGINGS_AUDIT_DENYLIST or ~/.config/lodgings/self-audit.denylist);"
              " an audit without it is not a pass")
        return 2
    terms = [t for path in paths for t in load_denylist(path)]
    roots = [os.path.abspath(r) for r in (args.roots or DEFAULT_ROOTS)]
    hits, scanned = [], 0
    for f in files(roots):
        rel = os.path.relpath(f, REPO).replace(os.sep, "/")
        try:
            with open(f, "r", encoding="utf-8") as fh:
                lines = fh.read().splitlines()
        except UnicodeDecodeError:
            hits.append("%s:0: binary file in the product tree" % rel)
            continue
        scanned += 1
        for number, line in enumerate(lines, 1):
            low = line.lower()
            licence = os.path.basename(f) == "LICENSE" and LICENSE_LINE.match(line)
            if not licence:
                for index, term in enumerate(terms, 1):
                    if term in low:
                        hits.append("%s:%d: denylist term #%d" % (rel, number, index))
            for rule, rx in BUILTIN:
                m = rx.search(line)
                if m and not (rule == "home path" and ALLOWED_PATHS.search(line)):
                    hits.append("%s:%d: %s" % (rel, number, rule))
    for h in hits:
        print(h)
    verdict = "clean" if not hits else "FAIL"
    print("%s · %d file(s) scanned · %d finding(s) · %d denylist term(s) from %s" % (
        verdict, scanned, len(hits), len(terms), "%d external file(s)" % len(paths)))
    return 0 if not hits else 1


if __name__ == "__main__":
    sys.exit(main())
