#!/usr/bin/env python3
"""Build the distributable archive: dist/lodgings-<version>.zip, after the self-audit passes.

    python3 scripts/build-package [--out DIR] [--denylist FILE]

The zip holds only the product (command, package, docs, examples, licence, package metadata and the community files)
under one top-level folder, so it unzips cleanly on Windows, macOS and Linux. It never includes scripts, tests or anything ignored by git. The Windows launcher is written with CRLF line endings and the POSIX
launcher is marked executable. A relative link in a shipped .md file that points at something the zip does not hold (core/passport)
is written as its plain link text, so no link in the zip is dangling. It refuses to build when the self-audit finds anything.
Same input, same bytes: every entry is stamped with one fixed time, SOURCE_DATE_EPOCH when set, else the commit time of HEAD, else (not
a git checkout, e.g. an unzipped source tree) 1980-01-01, so two clones of the same commit give the same zip, whatever the files'
mtimes; the build prints the stamp. The files are read as checked out, so a checkout that rewrites line ends (Git for Windows'
default `core.autocrlf=true`) gives different bytes: clone with `-c core.autocrlf=false`. Standard library only.
"""
import argparse
import os
import posixpath
import re
import subprocess
import sys
import time
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
INCLUDE = ["README.md", "LICENSE", "CHANGELOG.md", "MIGRATION.md", "CONTRIBUTING.md", "SECURITY.md", "SUPPORT.md", "CODE_OF_CONDUCT.md",
           "pyproject.toml",
           "bin", "src", "docs", "examples"]
SKIP_PARTS = {"__pycache__", ".git", "dist", "state", "demo-state"}
EXEC = {"bin/lodgings"}


def version():
    return re.search(r'VERSION = "([^"]+)"', (ROOT / "src" / "lodgings" / "__init__.py").read_text()).group(1)


def files():
    out = []   # entries sorted by name parts, case-sensitively: sorted(Path) folds case on Windows and would order the zip differently there
    for item in INCLUDE:
        path = ROOT / item
        if path.is_file():
            out.append(path)
        else:
            out += [p for p in sorted(path.rglob("*"), key=lambda p: p.relative_to(ROOT).parts) if p.is_file() and not (SKIP_PARTS & set(p.relative_to(ROOT).parts)) and p.suffix != ".pyc"]
    return out


def stamp_epoch():
    """The one time every zip entry carries: not the working tree's mtimes, which differ between clones of the same commit."""
    if os.environ.get("SOURCE_DATE_EPOCH", "").strip():
        return max(int(os.environ["SOURCE_DATE_EPOCH"]), 315532800)
    try:
        git = lambda *a: subprocess.run(["git", "-C", str(ROOT), *a], capture_output=True, text=True, check=True).stdout.strip()
        if Path(git("rev-parse", "--show-toplevel")).resolve() == ROOT:  # ROOT itself is the checkout, not a folder inside another repository
            return max(int(git("log", "-1", "--format=%ct", "HEAD")), 315532800)
    except (OSError, ValueError, subprocess.CalledProcessError):
        pass
    return 315532800  # 1980-01-01, the earliest time a zip entry can hold (earlier epochs are raised to it)


LINK = re.compile(r"\[([^\]]+)\]\(([^)\s]+)\)")


def unlink_missing(rel, text, shipped):
    """-> (text, count): links to a relative target outside `shipped` become their link text. Fenced code is left alone."""
    count = 0

    def one(m):
        nonlocal count
        target = m.group(2)
        if re.match(r"[A-Za-z][A-Za-z0-9+.-]*:", target) or target.startswith("#"):
            return m.group(0)
        if posixpath.normpath(posixpath.join(posixpath.dirname(rel), target.split("#")[0])) in shipped:
            return m.group(0)
        count += 1
        return m.group(1)

    parts = text.split("```")
    for i in range(0, len(parts), 2):
        parts[i] = LINK.sub(one, parts[i])
    return "```".join(parts), count


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--out", default=str(ROOT / "dist"))
    ap.add_argument("--denylist", help="names that must not appear (kept outside the repository)")
    args = ap.parse_args()
    audit = [sys.executable, str(ROOT / "scripts" / "self-audit"), str(ROOT)] + (["--denylist", args.denylist] if args.denylist else [])
    res = subprocess.run(audit, capture_output=True, text=True)
    if res.returncode != 0:
        sys.stdout.write(res.stdout)
        print("build-package: the self-audit found problems; nothing was built")
        return 1
    ver = version()
    top = "lodgings-%s" % ver
    out_dir = Path(args.out)
    out_dir.mkdir(parents=True, exist_ok=True)
    target = out_dir / (top + ".zip")
    epoch = stamp_epoch()
    stamp = time.gmtime(epoch)[:6]
    print("entry time " + time.strftime("%Y-%m-%d %H:%M:%SZ", time.gmtime(epoch)))
    paths = files()
    shipped = set()
    for path in paths:
        rel = posixpath.normpath(path.relative_to(ROOT).as_posix())
        while rel != ".":
            shipped.add(rel)
            rel = posixpath.dirname(rel) or "."
    unlinked = 0
    with zipfile.ZipFile(target, "w", zipfile.ZIP_DEFLATED) as zf:
        for path in paths:
            rel = path.relative_to(ROOT).as_posix()
            data = path.read_bytes()
            if rel.endswith(".md"):
                text, n = unlink_missing(rel, data.decode("utf-8"), shipped)
                data, unlinked = text.encode("utf-8"), unlinked + n
            if rel.endswith(".cmd"):
                data = data.replace(b"\r\n", b"\n").replace(b"\n", b"\r\n")
            info = zipfile.ZipInfo("%s/%s" % (top, rel), date_time=stamp)
            info.compress_type = zipfile.ZIP_DEFLATED
            info.create_system = 3   # the same "made on Unix" header from any OS (zipfile writes 0 on Windows), as the permissions below say
            info.external_attr = (0o755 if rel in EXEC else 0o644) << 16
            zf.writestr(info, data)
    print("built %s (%d files; %d links to files outside the zip written as plain text)" % (target, len(paths), unlinked))
    return 0


if __name__ == "__main__":
    sys.exit(main())
